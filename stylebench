#!/usr/bin/env ruby
require "digest"
require "fileutils"
require "json"
require "open3"
require "optparse"
require "tmpdir"
require "yaml"

$stdout.sync = true

ROOT = __dir__
LOCAL_CONFIG = File.join(ROOT, "stylebench.local.yml")
CONFIG = YAML.load_file(File.join(ROOT, "stylebench.yml"))
  .merge(File.exist?(LOCAL_CONFIG) ? YAML.load_file(LOCAL_CONFIG) : {})
BUNDLE = { "BUNDLE_GEMFILE" => File.join(ROOT, "Gemfile") }
THINKING = /:(off|minimal|low|medium|high|xhigh|max)\z/
OUT = File.join(ROOT, "out")
RESULTS = File.join(OUT, "results")
SITE = File.join(OUT, "site")
RUN_TIMEOUT = 900

Prompt = Data.define(:id, :name, :file, :body, :starter) do
  def self.all
    Dir[File.join(ROOT, "prompts", "*", "prompt.md")].sort.map { |path| load(File.dirname(path)) }
  end

  def self.load(dir)
    _, front, body = File.read(File.join(dir, "prompt.md")).split(/^---\s*$/, 3)
    meta = YAML.safe_load(front)
    starter = Dir[File.join(dir, "starter", "**", "*")].select { |f| File.file?(f) }.sort.to_h do |f|
      [f.delete_prefix(File.join(dir, "starter") + "/"), File.read(f)]
    end
    new(File.basename(dir), meta.fetch("name"), meta.fetch("file"), body.strip, starter)
  end

  def message
    starter.key?(file) ? body : "#{body}\n\nPut it in `#{file}`."
  end
end

def variant_text(variant)
  variant && File.read(File.join(ROOT, "variants", "#{variant}.md"))
end

def result_path(model, variant, prompt)
  File.join(RESULTS, model.gsub(/[\/:]/, "~"), variant || "none", "#{prompt.id}.json")
end

def fingerprint(model, variant, prompt)
  Digest::SHA256.hexdigest(JSON.dump([model, variant_text(variant), prompt.message, prompt.starter]))
end

def pi_base
  CONFIG.fetch("pi", ["pi"]) + %w[-ne --no-mcp] + CONFIG.fetch("extensions", []).flat_map { |ext| ["-e", File.expand_path(ext)] }
end

def check_models(models)
  out, err, status = Open3.capture3(*pi_base, "--list-models")
  abort "Pi failed to list models:\n#{err}" unless status.success?
  available = out.lines.drop(1).filter_map { |l| l.split.first(2).join("/") if l.split.size >= 2 }
  missing = models.reject { |m| available.include?(m.sub(THINKING, "")) }
  return if missing.empty?
  abort <<~MESSAGE
    Pi has no access to these models:
      #{missing.join("\n  ")}

    See what you can use with `pi --list-models`, then either pass models on the
    command line or list them under `models:` in stylebench.local.yml.
  MESSAGE
rescue Errno::ENOENT
  abort "Could not run `#{CONFIG.fetch("pi", ["pi"]).first}`. Install Pi (https://pi.dev) or set `pi:` in stylebench.local.yml."
end

def pi_command(model, variant, prompt)
  cmd = pi_base + %w[-p --mode json -nc -ns --no-session --tools read,write,edit,bash --model] + [model]
  cmd += ["--append-system-prompt", File.join(ROOT, "variants", "#{variant}.md")] if variant
  cmd + [prompt.message]
end

def run_pi(cmd, dir)
  Open3.popen3(*cmd, chdir: dir, pgroup: true) do |stdin, stdout, stderr, wait|
    stdin.close
    out = Thread.new { stdout.read }
    err = Thread.new { stderr.read }
    unless wait.join(RUN_TIMEOUT)
      Process.kill("-TERM", wait.pid)
      return [out.value, "timed out after #{RUN_TIMEOUT}s"]
    end
    [out.value, wait.value.success? ? nil : err.value.strip]
  end
end

def parse_events(stdout)
  events = stdout.lines.filter_map { |l| JSON.parse(l) rescue nil }
  replies = events.select { |e| e["type"] == "message_end" && e.dig("message", "role") == "assistant" }
  last = replies.last&.fetch("message")
  text = last ? last["content"].select { |c| c["type"] == "text" }.map { |c| c["text"] }.join("\n").strip : ""
  error = last && last["stopReason"] == "error" ? last["errorMessage"] : nil
  [text, events.count { |e| e["type"] == "tool_execution_start" }, error]
end

def run_one(model, variant, prompt)
  Dir.mktmpdir("stylebench-") do |dir|
    prompt.starter.each do |name, content|
      FileUtils.mkdir_p(File.dirname(File.join(dir, name)))
      File.write(File.join(dir, name), content)
    end
    started = Time.now
    stdout, failure = run_pi(pi_command(model, variant, prompt), dir)
    reply, tools, error = parse_events(stdout)
    target = File.join(dir, prompt.file)
    from_reply = !File.exist?(target)
    code = from_reply ? reply[/```\w*\n(.*?)```/m, 1].to_s : File.read(target)
    {
      model:, variant:, prompt: prompt.id, fingerprint: fingerprint(model, variant, prompt),
      code:, from_reply:, reply:, tools:, seconds: (Time.now - started).round(1),
      error: error || failure&.then { |f| f.empty? ? "pi exited with an error" : f.lines.last(5).join },
    }
  end
end

def cached?(model, variant, prompt)
  path = result_path(model, variant, prompt)
  return false unless File.exist?(path)
  result = JSON.parse(File.read(path))
  result["fingerprint"] == fingerprint(model, variant, prompt) && !result["error"]
end

def average_seconds(model)
  times = Dir[File.join(RESULTS, model.gsub(/[\/:]/, "~"), "*", "*.json")].map { |f| JSON.parse(File.read(f))["seconds"] }
  times.empty? ? Float::INFINITY : times.sum / times.size
end

def run(models, variants, force, only, jobs, per_provider)
  prompts = Prompt.all
  prompts.select! { |p| only.include?(p.id) } if only.any?
  models = models.sort_by { |m| -average_seconds(m) }
  work = prompts.product(variants, models).map { |p, v, m| [m, v, p] }
  all = work.size
  work.reject! { |m, v, p| cached?(m, v, p) } unless force
  total = work.size
  puts "#{total} runs to do, #{all - total} cached"
  check_models(work.map(&:first).uniq) if work.any?
  lock = Mutex.new
  slots = Hash.new(0)
  freed = ConditionVariable.new
  done = 0
  take = lambda do
    lock.synchronize do
      loop do
        return nil if work.empty?
        index = work.index { |m, _, _| slots[m.split("/").first] < per_provider }
        if index
          job = work.delete_at(index)
          slots[job[0].split("/").first] += 1
          return job
        end
        freed.wait(lock)
      end
    end
  end
  Array.new(jobs) do
    Thread.new do
      while (job = take.call)
        model, variant, prompt = job
        result = run_one(model, variant, prompt)
        path = result_path(model, variant, prompt)
        FileUtils.mkdir_p(File.dirname(path))
        File.write(path, JSON.pretty_generate(result))
        lock.synchronize do
          slots[model.split("/").first] -= 1
          freed.broadcast
          done += 1
          status = result[:error] ? "error: #{result[:error].lines.first&.strip}" : "#{result[:seconds]}s"
          puts "[#{done}/#{total}] #{model} #{variant || "-"} #{prompt.id} #{status}"
        end
      end
    end
  end.each(&:join)
end

def loc(code)
  code.lines.count { |l| !l.strip.empty? && !l.lstrip.start_with?("#") }
end

def changed_lines(before, after)
  a = before.lines.map(&:rstrip)
  b = after.lines.map(&:rstrip)
  table = Array.new(a.size + 1) { Array.new(b.size + 1, 0) }
  a.size.downto(1) do |i|
    b.size.downto(1) do |j|
      table[i - 1][j - 1] = a[i - 1] == b[j - 1] ? table[i][j] + 1 : [table[i - 1][j], table[i][j - 1]].max
    end
  end
  kept = []
  i = j = 0
  while i < a.size && j < b.size
    if a[i] == b[j]
      kept << j
      i += 1
      j += 1
    elsif table[i + 1][j] >= table[i][j + 1]
      i += 1
    else
      j += 1
    end
  end
  (0...b.size).to_a - kept
end

def install_gems
  return if system(BUNDLE, "bundle", "check", out: File::NULL, err: File::NULL)
  puts "Installing gems"
  system(BUNDLE, "bundle", "install", exception: true)
rescue Errno::ENOENT
  abort "Bundler is missing. Run `gem install bundler` and try again."
end

def offences(results)
  install_gems
  Dir.mktmpdir("stylebench-lint-") do |dir|
    results.each_with_index { |r, i| File.write(File.join(dir, "#{i}.rb"), r["code"]) }
    out, err, = Open3.capture3(BUNDLE, "bundle", "exec", "standardrb", "--format", "json", dir)
    abort "Standard failed:\n#{err}" if out.empty?
    counts = JSON.parse(out).fetch("files").to_h { |f| [File.basename(f["path"], ".rb").to_i, f["offenses"].size] }
    results.each_with_index { |r, i| r["offences"] = counts.fetch(i, 0) }
  end
end

def origin
  url, status = Open3.capture2("git", "remote", "get-url", "origin", chdir: ROOT, err: File::NULL)
  url.strip if status.success?
end

def repo_url
  origin&.sub(/\Agit@([^:]+):/, "https://\\1/")&.delete_suffix(".git")&.then { |url| url if url.start_with?("https://") }
end

def build
  prompts = Prompt.all
  results = Dir[File.join(RESULTS, "**", "*.json")].map { |f| JSON.parse(File.read(f)) }
  offences(results)
  order = CONFIG.fetch("models")
  columns = results.map { |r| [r["model"], r["variant"]] }.uniq.sort_by do |model, variant|
    [order.index(model) || order.size, model, variant.to_s]
  end.map do |model, variant|
    { id: "#{model}|#{variant}", key: model, model: model.split("/", 2).last, variant: }
  end
  by_key = results.group_by { |r| "#{r["model"]}|#{r["variant"]}" }
  data = {
    repo: repo_url,
    columns:,
    variants: Dir[File.join(ROOT, "variants", "*.md")].to_h { |f| [File.basename(f, ".md"), File.read(f)] },
    prompts: prompts.map do |p|
      out = by_key.to_h do |key, rs|
        r = rs.find { |x| x["prompt"] == p.id }
        next [key, nil] unless r
        starter = p.starter[p.file]
        [key, {
          code: r["code"], reply: r["reply"], tools: r["tools"], loc: loc(r["code"]), error: r["error"],
          seconds: r["seconds"], offences: r["offences"],
          fromReply: r["from_reply"], changed: starter ? changed_lines(starter, r["code"]) : [],
          stale: r["fingerprint"] != fingerprint(r["model"], r["variant"], p),
        }]
      end
      { id: p.id, name: p.name, text: p.body, given: p.starter, out: }
    end,
  }
  html = File.read(File.join(ROOT, "lib", "template.html"))
    .sub("/*DATA*/null") { JSON.generate(data).gsub("</") { "<\\/" } }
  FileUtils.mkdir_p(SITE)
  File.write(File.join(SITE, "index.html"), html)
  File.join(SITE, "index.html")
end

command = ARGV.shift
case command
when "run"
  opts = { variants: [], force: false, only: [], jobs: 32, per_provider: 12 }
  OptionParser.new do |o|
    o.banner = "Usage: stylebench run [MODEL...] [options]"
    o.on("--variant NAME", "Append variants/NAME.md to the system prompt; 'none' for no variant (repeatable)") { |v| opts[:variants] << v }
    o.on("--force", "Rerun even if a result is cached") { opts[:force] = true }
    o.on("--only PROMPT", "Only run this prompt (repeatable)") { |v| opts[:only] << v }
    o.on("-j N", Integer, "Parallel runs (default 32)") { |v| opts[:jobs] = v }
    o.on("--per-provider N", Integer, "Parallel runs per provider (default 12)") { |v| opts[:per_provider] = v }
  end.parse!
  variants = (opts[:variants].empty? ? ["none"] : opts[:variants]).map { |v| v == "none" ? nil : v }
  variants.compact.each { |v| abort "No variant at variants/#{v}.md" unless File.exist?(File.join(ROOT, "variants", "#{v}.md")) }
  run(ARGV.empty? ? CONFIG.fetch("models") : ARGV, variants, opts[:force], opts[:only], opts[:jobs], opts[:per_provider])
  puts "Built #{build}"
when "build"
  puts "Built #{build}"
when "open"
  page = build
  opener = RbConfig::CONFIG["host_os"].match?(/darwin/) ? "open" : "xdg-open"
  puts "Built #{page}" unless system(opener, page, err: File::NULL)
when "publish"
  remote = origin or abort "No `origin` remote to publish to."
  build
  Dir.mktmpdir("stylebench-pages-") do |dir|
    FileUtils.cp_r(File.join(SITE, "."), dir)
    FileUtils.touch(File.join(dir, ".nojekyll"))
    [
      %w[git init -q -b gh-pages],
      %w[git add -A],
      ["git", "commit", "-q", "-m", "Publish #{Time.now.strftime("%F %R")}"],
      ["git", "push", "-q", "--force", remote, "gh-pages"],
    ].each { |cmd| system(*cmd, chdir: dir, exception: true) }
  end
  puts "Published"
else
  abort <<~USAGE
    Usage:
      stylebench run [MODEL...] [--variant NAME|none]... [--force] [--only PROMPT] [-j N] [--per-provider N]
      stylebench build
      stylebench open
      stylebench publish
  USAGE
end
